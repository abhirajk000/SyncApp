{
  "$schema": "./tokens.schema.json",
  "description": "SyncBridge animation library — durations, easings, and named presets",
  "durations": {
    "fast": 150,
    "normal": 250,
    "slow": 350,
    "slower": 500
  },
  "easings": {
    "out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "liquid": "cubic-bezier(0.34, 1.2, 0.64, 1)",
    "inOut": "cubic-bezier(0.45, 0, 0.55, 1)"
  },
  "presets": {
    "fadeIn": {
      "property": "opacity",
      "from": 0,
      "to": 1,
      "duration": "normal",
      "easing": "out"
    },
    "fadeOut": {
      "property": "opacity",
      "from": 1,
      "to": 0,
      "duration": "fast",
      "easing": "out"
    },
    "slideUp": {
      "property": "transform",
      "from": "translateY(12px)",
      "to": "translateY(0)",
      "duration": "normal",
      "easing": "out",
      "paired": "fadeIn"
    },
    "slideDown": {
      "property": "transform",
      "from": "translateY(-8px)",
      "to": "translateY(0)",
      "duration": "normal",
      "easing": "out"
    },
    "scaleIn": {
      "property": "transform",
      "from": "scale(0.96)",
      "to": "scale(1)",
      "duration": "normal",
      "easing": "liquid"
    },
    "modalEnter": {
      "duration": "slow",
      "easing": "liquid",
      "paired": ["fadeIn", "scaleIn"]
    },
    "progressPulse": {
      "property": "opacity",
      "keyframes": [0.4, 0.7, 0.4],
      "duration": "slower",
      "easing": "inOut",
      "iteration": "infinite"
    },
    "successPop": {
      "property": "transform",
      "from": "scale(0.85)",
      "to": "scale(1)",
      "duration": "slow",
      "easing": "liquid"
    },
    "dockPress": {
      "property": "transform",
      "from": "scale(1)",
      "to": "scale(0.94)",
      "duration": "fast",
      "easing": "out"
    },
    "liquidFloat": {
      "property": "transform",
      "keyframes": [
        "translate(0,0) scale(1)",
        "translate(30px,-20px) scale(1.05)",
        "translate(-20px,15px) scale(0.95)"
      ],
      "duration": 22000,
      "easing": "inOut",
      "iteration": "infinite"
    }
  },
  "allowedTypes": [
    "fade",
    "scale",
    "slide",
    "sharedElement",
    "progress",
    "success",
    "error"
  ]
}
