{
  "$schema": "./tokens.schema.json",
  "version": "4.0.0",
  "description": "SyncBridge global design tokens — canonical source for all platforms",

  "typography": {
    "fontFamily": "Outfit",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "sizes": {
      "xs": 12,
      "sm": 14,
      "base": 16,
      "lg": 18,
      "xl": 20,
      "2xl": 24,
      "3xl": 32,
      "display": 40
    },
    "lineHeights": {
      "tight": 1.2,
      "normal": 1.55,
      "relaxed": 1.7
    },
    "letterSpacing": {
      "tight": -0.02,
      "normal": 0,
      "wide": 0.08
    },
    "roles": {
      "display": { "size": "display", "weight": "bold", "lineHeight": "tight" },
      "title2xl": { "size": "2xl", "weight": "bold", "lineHeight": "tight" },
      "titleXl": { "size": "xl", "weight": "semibold", "lineHeight": "tight" },
      "titleLg": { "size": "lg", "weight": "semibold", "lineHeight": "normal" },
      "body": { "size": "base", "weight": "regular", "lineHeight": "normal" },
      "bodySm": { "size": "sm", "weight": "regular", "lineHeight": "normal" },
      "caption": { "size": "xs", "weight": "medium", "lineHeight": "normal" },
      "label": { "size": "xs", "weight": "bold", "lineHeight": "normal", "letterSpacing": "wide" }
    }
  },

  "colors": {
    "light": {
      "primary": "#0D9488",
      "primaryHover": "#0F766E",
      "primaryLight": "#14B8A6",
      "secondary": "#4F46E5",
      "secondaryHover": "#4338CA",
      "background": "#F4F7FB",
      "backgroundElevated": "#FFFFFF",
      "backgroundSubtle": "#EEF2F7",
      "surface": "rgba(255,255,255,0.72)",
      "surfaceElevated": "rgba(255,255,255,0.85)",
      "border": "rgba(15,23,42,0.08)",
      "borderStrong": "rgba(15,23,42,0.14)",
      "textPrimary": "#0C1222",
      "textSecondary": "#5C6B82",
      "textMuted": "#8B9BB5",
      "success": "#059669",
      "warning": "#D97706",
      "danger": "#DC2626",
      "accent": "#7C3AED",
      "dockInactive": "#94A3B8",
      "dockActiveGreen": "#15803D",
      "dockActiveBg": "rgba(187,247,208,0.9)",
      "dockActiveBorder": "rgba(74,222,128,0.55)"
    },
    "dark": {
      "primary": "#2DD4BF",
      "primaryHover": "#14B8A6",
      "primaryLight": "#5EEAD4",
      "secondary": "#818CF8",
      "secondaryHover": "#6366F1",
      "background": "#080D18",
      "backgroundElevated": "#111827",
      "backgroundSubtle": "#1A2332",
      "surface": "rgba(17,24,39,0.72)",
      "surfaceElevated": "rgba(17,24,39,0.88)",
      "border": "rgba(248,250,252,0.08)",
      "borderStrong": "rgba(248,250,252,0.14)",
      "textPrimary": "#F1F5F9",
      "textSecondary": "#94A3B8",
      "textMuted": "#64748B",
      "success": "#34D399",
      "warning": "#FBBF24",
      "danger": "#F87171",
      "accent": "#A78BFA",
      "dockInactive": "#64748B",
      "dockActiveGreen": "#34D399",
      "dockActiveBg": "rgba(8,53,30,0.9)",
      "dockActiveBorder": "rgba(52,211,153,0.45)"
    },
    "semantic": {
      "transferCloud": { "bg": "#1F4F46E5", "fg": "#4F46E5", "border": "#334F46E5" },
      "transferLan": { "bg": "#1F059669", "fg": "#059669", "border": "#40059669" },
      "transferRtc": { "bg": "#1F7C3AED", "fg": "#7C3AED", "border": "#337C3AED" },
      "fabGradient": ["#4F46E5", "#4F46E5", "#7C3AED"]
    }
  },

  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },

  "radius": {
    "sm": 8,
    "md": 14,
    "input": 18,
    "button": 20,
    "lg": 20,
    "containerInner": 20,
    "containerSm": 24,
    "card": 28,
    "container": 28,
    "dialog": 32,
    "containerLg": 32,
    "chip": 9999
  },

  "shadow": {
    "small": "0 2px 8px rgba(15,23,42,0.06)",
    "medium": "0 8px 24px rgba(15,23,42,0.08)",
    "large": "0 16px 48px rgba(15,23,42,0.12)",
    "floating": "0 24px 64px -16px rgba(15,23,42,0.18), 0 8px 24px -8px rgba(79,70,229,0.15)"
  },

  "icon": {
    "sm": 16,
    "md": 20,
    "base": 24,
    "lg": 28,
    "xl": 32,
    "2xl": 40
  },

  "animation": {
    "duration": {
      "fast": 150,
      "normal": 250,
      "slow": 350,
      "slower": 500
    },
    "easing": {
      "out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "liquid": "cubic-bezier(0.34, 1.2, 0.64, 1)",
      "inOut": "cubic-bezier(0.45, 0, 0.55, 1)"
    }
  },

  "layout": {
    "headerHeight": 64,
    "dockHeight": 66,
    "bottomNavHeight": 72,
    "sidebarWidth": 260,
    "maxContentWidth": 720
  },

  "zIndex": {
    "base": 0,
    "raised": 10,
    "dock": 100,
    "overlay": 200,
    "modal": 300,
    "toast": 400
  }
}
