# SyncBridge API — Environment Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
#
# The API auto-loads .env from the working directory at startup.
# In production, set real environment variables instead of using .env.

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development          # development | staging | production

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgres://user:password@host:port/dbname?sslmode=disable
# For Docker Compose use: postgres://syncbridge:syncbridge@localhost:5432/syncbridge?sslmode=disable
DATABASE_URL=postgres://syncbridge:syncbridge@localhost:5432/syncbridge?sslmode=disable

DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m

# ── Migrations ────────────────────────────────────────────────────────────────
RUN_MIGRATIONS=true              # auto-run on startup
MIGRATIONS_PATH=migrations       # relative to working directory

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug                  # debug | info | warn | error
LOG_FORMAT=pretty                # json (production) | pretty (development)

# ── Object Storage ────────────────────────────────────────────────────────────
# Default: local filesystem at /opt/syncbridge/storage (no MinIO/S3 required).
OBJECT_STORAGE_TYPE=local
OBJECT_STORAGE_PATH=/opt/syncbridge/storage

# Optional S3 (feature flag only — not required)
#OBJECT_STORAGE_TYPE=s3
#S3_BUCKET=syncbridge-files
#S3_ENDPOINT=

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_CLIPBOARD_SIZE_MB=10
MAX_FILE_SIZE_MB=1024
DEFAULT_CHUNK_SIZE_MB=4
DEFAULT_RETENTION_MINUTES=120

# ── PIN Authentication ────────────────────────────────────────────────────────
# Master PIN is stored in DB (default 070901). Device trust window:
DEVICE_TRUST_DAYS=7
MAX_DEVICES=5

# ── Storage quota & transfer thresholds ───────────────────────────────────────
MAX_UNPINNED_STORAGE_GB=1
RELAY_AUTO_MAX_MB=100
AUTO_CLOUD_MAX_MB=1024

# Session signing secret (≥32 chars). Generate with: openssl rand -hex 32
JWT_SECRET=syncbridge-dev-session-secret-32chars!!
JWT_ACCESS_TOKEN_TTL=168h
JWT_REFRESH_TOKEN_TTL=168h

# ── WebSocket (Phase 6) ───────────────────────────────────────────────────────
WS_PING_INTERVAL_SEC=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── TLS ───────────────────────────────────────────────────────────────────────
TLS_MODE=off                     # auto | manual | off (Caddy handles TLS in production)

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# General API: 60 requests per IP per 60-second window.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SEC=60
# Auth endpoints (PIN unlock): 10 attempts per IP per 60 s.
AUTH_RATE_LIMIT_MAX=10

# ── TURN Server (Phase 4+) ────────────────────────────────────────────────────
# Shared HMAC secret for coturn time-limited credentials.
# Generate with: openssl rand -hex 32
#TURN_SECRET=

# ── mDNS / Local Network Discovery (Phase 6) ─────────────────────────────────
# Set MDNS_ENABLED=false in Docker or any environment without multicast UDP.
MDNS_ENABLED=true
# Optional: human-readable mDNS service name (default: "SyncBridge@<hostname>")
#MDNS_INSTANCE_NAME=SyncBridge Home
# Optional: stable instance UUID for TXT records
#MDNS_INSTANCE_ID=

# ── WebRTC STUN / TURN (Phase 6) ─────────────────────────────────────────────
# Comma-separated STUN URIs (default: Google public STUN).
STUN_URLS=stun:stun.l.google.com:19302
# Comma-separated TURN URIs (leave empty for STUN-only mode).
#TURN_URLS=turn:turn.example.com:3478
# Shared HMAC-SHA1 secret for coturn --use-auth-secret mode.
# Generate with: openssl rand -hex 32
#TURN_SECRET=

# How long (minutes) a local-peer LAN advertisement stays valid.
# Devices must re-advertise within this window.
LAN_ADVERTISE_TTL_MIN=10
