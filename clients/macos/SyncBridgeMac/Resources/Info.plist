<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>SyncBridge</string>

    <key>CFBundleDisplayName</key>
    <string>SyncBridge</string>

    <key>CFBundleIdentifier</key>
    <string>com.syncbridge.mac</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>

    <key>CFBundleIconFile</key>
    <string>AppIcon</string>

    <key>CFBundleIconName</key>
    <string>AppIcon</string>

    <!-- Hide from Dock and App Switcher — menu-bar-only app -->
    <key>LSUIElement</key>
    <true/>

    <!-- Minimum macOS version -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <!-- Privacy strings (macOS 14+ clipboard access prompt) -->
    <key>NSPasteboardUsageDescription</key>
    <string>SyncBridge reads and writes the clipboard to sync content across your devices.</string>

    <!-- Bonjour / Local Send -->
    <key>ATSApplicationFontsPath</key>
    <string>Fonts</string>

    <key>NSLocalNetworkUsageDescription</key>
    <string>SyncBridge discovers nearby devices on your Wi-Fi for Local Send file transfer.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_syncbridge-localsend._tcp</string>
    </array>

    <!-- Network access reason (shown in privacy report) -->
    <key>NSNetworkVolumesUsageDescription</key>
    <string>SyncBridge connects to your SyncBridge server to sync clipboard and files.</string>

    <!-- App Transport Security: allow HTTP for local/self-hosted servers -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <false/>
    </dict>
</dict>
</plist>
