# SyncApp VPS production config — sourced by scripts/vps/*.sh
SYNC_WEB_DOMAIN=sync.abhiraj.xyz
# Public API URL (same host as web — Cloudflare SSL compatible)
SYNC_API_DOMAIN=sync.abhiraj.xyz
SYNC_API_DIRECT_DOMAIN=api.sync.abhiraj.xyz
SYNC_WEB_LOCAL=http://127.0.0.1:2000
SYNC_API_LOCAL=http://127.0.0.1:2001
SYNC_DB_NAME=syncbridge
SYNC_DB_USER=syncbridge_user
SYNC_STORAGE_PATH=/opt/syncbridge/storage
SYNC_COMPOSE_FILE=docker-compose.vps.yml
SYNC_COMPOSE_PROJECT=syncbridge
VITE_API_URL=https://sync.abhiraj.xyz
CORS_ORIGINS=https://sync.abhiraj.xyz
